<%
  var tp = typeof themePath !== 'undefined' ? themePath : '/themes/wotlk';
  var currentTheme = typeof theme !== 'undefined' ? theme : 'wotlk';
  // Theme-based map availability:
  // vanilla = Azeroth, tbc = Azeroth + Outland, wotlk = all maps.
  var showOutland = (currentTheme === 'tbc' || currentTheme === 'wotlk');
  var showNorthrend = (currentTheme === 'wotlk');
  var mapsCount = 1 + (showOutland ? 1 : 0) + (showNorthrend ? 1 : 0);
%>

<style type="text/css">
  /* Playermap is a wide utility page inside the classic V4 shell. */
  #left-bg {
    background-image: url('<%= tp %>/images/leftbg.png') !important;
    background-repeat: no-repeat !important;
    background-position: 0 0 !important;
    background-color: transparent !important;
  }
  #left-bg::before,
  #left-bg::after {
    content: none !important;
    display: none !important;
  }
  .playermap-page {
    width: 650px;
    max-width: 100%;
    box-sizing: border-box;
    margin: -8px auto 0 auto;
    color: #1f1608;
    font-family: Georgia, "Times New Roman", Times, serif;
    font-size: 13px;
  }
  .playermap-page a,
  .playermap-page a:visited {
    color: #d0a803;
    font-weight: bold;
    text-decoration: none;
  }
  .playermap-page a:hover,
  .playermap-page button:hover {
    color: #fff4bf;
  }
  .playermap-frame {
    width: 100%;
    margin: 0 0 8px 0;
  }
  .playermap-frame > table,
  .playermap-status-wrap > table {
    width: 100%;
    table-layout: fixed;
  }
  .playermap-toolbar {
    min-height: 31px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    width: 100%;
    box-sizing: border-box;
    background: #070707 url('<%= tp %>/images/shadow.gif') repeat-x 0 100%;
    border: 1px solid #1e1d1c;
    border-bottom-color: #050505;
  }
  .playermap-tabs,
  .playermap-actions {
    display: flex;
    align-items: center;
    padding: 0 11px;
    white-space: nowrap;
  }
  .playermap-tabs {
    flex: 0 1 auto;
    min-width: 0;
    justify-content: flex-start;
  }
  .playermap-actions {
    flex: 1 0 auto;
    justify-content: flex-end;
    gap: 4px;
  }
  .map-tab,
  .map-action {
    appearance: none;
    -webkit-appearance: none;
    display: inline-block;
    margin: 0;
    padding: 2px 8px;
    border: 0;
    background: transparent;
    color: #d0a803;
    cursor: pointer;
    font: bold 12px Georgia, "Times New Roman", Times, serif;
    text-decoration: none;
    text-shadow: 1px 1px 0 #000;
  }
  .map-zoom {
    min-width: 18px;
    padding-left: 6px;
    padding-right: 6px;
    text-align: center;
  }
  .map-zoom-reset {
    min-width: 42px;
  }
  .playermap-zoom-controls {
    display: inline-flex;
    align-items: center;
    gap: 1px;
    margin: 0 3px;
    padding: 0 4px;
    border-left: 1px solid #34240d;
    border-right: 1px solid #34240d;
  }
  .map-tab.active {
    color: #f4c400;
    background: rgba(99, 9, 9, 0.42);
    outline: 1px solid #352613;
  }
  .playermap-separator {
    color: #806028;
    padding: 0 5px;
    font-weight: bold;
  }
  .playermap-stage {
    width: 100%;
    overflow: hidden;
    padding: 6px;
    background: #000;
    border-left: 1px solid #1e1d1c;
    border-right: 1px solid #1e1d1c;
    border-bottom: 1px solid #1e1d1c;
    text-align: center;
    box-sizing: border-box;
  }
  .playermap-outer {
    position: relative;
    box-sizing: content-box;
    width: 640px;
    height: 320px;
    margin: 0 auto;
    overflow: hidden;
    background: #000;
    border: 1px solid #000;
    outline: 1px solid #3d321d;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }
  .playermap-outer.dragging {
    cursor: grabbing;
  }
  .playermap-inner {
    position: absolute;
    top: 0;
    left: 0;
    width: 966px;
    height: 732px;
  }
  .map-layer,
  .points-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 966px;
    height: 732px;
  }
  .map-layer {
    background-size: 966px 732px;
    background-repeat: no-repeat;
    image-rendering: auto;
  }
  .points-layer {
    transform-origin: 0 0;
  }
  #world { z-index: 10; }
  #outland { z-index: 9; visibility: hidden; }
  #northrend { z-index: 8; visibility: hidden; }
  #pointsOldworld { z-index: 100; }
  #pointsOutland { z-index: 99; visibility: hidden; }
  #pointsNorthrend { z-index: 98; visibility: hidden; }

  td.playermapRow1 {
    font-size: 12px;
    border-style: solid;
    border-width: 0 1px 1px 0;
    border-color: #D8BF95;
    padding: 4px 8px;
  }
  td.playermapRow2 {
    font-size: 12px;
    border-style: solid;
    border-width: 0 1px 1px 0;
    border-color: #D8BF95;
    background-color: #C3AD89;
    padding: 4px 8px;
  }
  td.rankingHeader {
    color: #C7C7C7;
    font-size: 10pt;
    font-family: arial, helvetica, sans-serif;
    font-weight: bold;
    background-color: #2E2D2B;
    border-style: solid;
    border-width: 1px;
    border-color: #5D5D5D #5D5D5D #1E1D1C #1E1D1C;
    padding: 2px 3px;
  }
  .playermap-status-wrap {
    margin-top: 5px;
  }
  .playermap-status-wrap table {
    border-collapse: collapse;
  }
  .playermap-loading,
  .playermap-error {
    padding: 10px;
    color: #660d02;
    font-weight: bold;
  }
  .ally-count {
    color: #064ea8;
    font-size: 14px;
  }
  .horde-count {
    color: #9a1000;
    font-size: 14px;
  }
  .total-count {
    color: rgb(35, 67, 3);
    font-size: 14px;
  }
  .bot-count {
    color: #49268f;
    font-size: 14px;
  }
  .playermap-legend {
    margin: 5px 4px 0;
    padding: 5px 8px 5px;
    border-top: 1px solid #a88950;
    border-bottom: 1px solid #a88950;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 12px;
    color: #2b1707;
  }
  .playermap-legend b {
    color: #640909;
    margin-right: 14px;
  }
  .playermap-legend span {
    display: inline-block;
    margin-right: 18px;
    white-space: nowrap;
  }
  .playermap-legend img {
    vertical-align: -2px;
    margin-right: 6px;
  }

  #maptip {
    position: fixed;
    z-index: 9999;
    pointer-events: none;
    left: -1000px;
    top: -1000px;
  }
  #maptip table {
    background: #1a1a1a;
    border: 1px solid #555;
    border-collapse: collapse;
  }
  .tip_header td {
    background: #2E2D2B;
    color: #f4c400;
    font-weight: bold;
    font-size: 11px;
    padding: 4px 8px;
    text-align: center;
  }
  .tip_head_text td {
    background: #3a3a3a;
    color: #aaa;
    font-size: 10px;
    padding: 2px 6px;
  }
  .tip_text td {
    color: #ddd;
    font-size: 11px;
    padding: 2px 5px;
    white-space: nowrap;
  }
  .tip_worldinfo td {
    color: #ddd;
    font-size: 11px;
    padding: 3px 6px;
  }
  .tip_single {
    background: #1a1a1a;
    border: 1px solid #555;
    padding: 6px;
  }
  .tip_single .name {
    font-weight: bold;
    font-size: 12px;
    padding-bottom: 3px;
  }
  .tip_single .info {
    font-size: 11px;
    color: #ccc;
    line-height: 1.5;
  }

  .playermap-page:fullscreen {
    overflow: auto;
    padding: 12px;
    background: #000;
  }
  .playermap-page:fullscreen .playermap-stage {
    min-height: calc(100vh - 170px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .playermap-page:fullscreen .playermap-status-wrap,
  .playermap-page:fullscreen .playermap-legend {
    max-width: 966px;
    margin-left: auto;
    margin-right: auto;
  }
</style>

<div class="playermap-page" id="playermap-page">
  <div class="playermap-frame">
    <%- include('../../partials/metalborder_header') %>
      <div class="playermap-toolbar">
        <div class="playermap-tabs">
          <button type="button" class="map-tab active" onclick="switchWorld(0)" id="btn-azeroth">Azeroth</button>
          <% if (showOutland) { %>
            <span class="playermap-separator">|</span>
            <button type="button" class="map-tab" onclick="switchWorld(1)" id="btn-outland">Outland</button>
          <% } %>
          <% if (showNorthrend) { %>
            <span class="playermap-separator">|</span>
            <button type="button" class="map-tab" onclick="switchWorld(2)" id="btn-northrend">Northrend</button>
          <% } %>
        </div>
        <div class="playermap-actions">
          <a class="map-action" href="/server">Server Status</a>
          <span class="playermap-separator">|</span>
          <a class="map-action" href="/">Back to Site</a>
          <span class="playermap-zoom-controls" aria-label="Map zoom controls">
            <button type="button" class="map-action map-zoom" onclick="zoomMapOut()" title="Zoom out">-</button>
            <button type="button" class="map-action map-zoom map-zoom-reset" onclick="resetMapZoom()" title="Reset zoom" id="map-zoom-label">100%</button>
            <button type="button" class="map-action map-zoom" onclick="zoomMapIn()" title="Zoom in">+</button>
          </span>
          <span class="playermap-separator">|</span>
          <button type="button" class="map-action" onclick="toggleMapFullscreen()">Fullscreen</button>
        </div>
      </div>

      <div class="playermap-stage">
        <div class="playermap-outer" id="playermap-outer">
          <div class="playermap-inner" id="playermap-inner">
            <div id="world" class="map-layer" style="background-image: url('/images/playermap/azeroth-redraw-ai-v2-4x.jpg'); visibility: visible;"></div>
            <% if (showOutland) { %>
              <div id="outland" class="map-layer" style="background-image: url('/images/playermap/outland-4x.jpg');"></div>
            <% } %>
            <% if (showNorthrend) { %>
              <div id="northrend" class="map-layer" style="background-image: url('/images/playermap/northrend-4x.jpg');"></div>
            <% } %>

            <div id="pointsOldworld" class="points-layer" style="visibility: visible;"></div>
            <% if (showOutland) { %>
              <div id="pointsOutland" class="points-layer"></div>
            <% } %>
            <% if (showNorthrend) { %>
              <div id="pointsNorthrend" class="points-layer"></div>
            <% } %>
          </div>
        </div>
      </div>
    <%- include('../../partials/metalborder_footer') %>
  </div>

  <div class="playermap-status-wrap">
    <%- include('../../partials/metalborder_header') %>
    <div id="server_info">
      <table cellpadding="3" cellspacing="0" width="100%">
        <tbody>
          <tr>
            <td class="rankingHeader" align="center">Status</td>
            <td class="rankingHeader" align="center">Players</td>
            <td class="rankingHeader" align="center">Bots</td>
            <td class="rankingHeader" align="center">Alliance</td>
            <td class="rankingHeader" align="center">Horde</td>
          </tr>
          <tr>
            <td class="playermapRow1" colspan="5"><div class="playermap-loading">Loading map data...</div></td>
          </tr>
        </tbody>
      </table>
    </div>
    <%- include('../../partials/metalborder_footer') %>
  </div>

  <div class="playermap-legend">
    <b>Legend:</b>
    <span><img src="/images/playermap/allia.gif" width="8" height="8" alt="">Alliance</span>
    <span><img src="/images/playermap/horde.gif" width="8" height="8" alt="">Horde</span>
    <span><img src="/images/playermap/group-icon.gif" width="12" height="12" alt="">Group</span>
    <span><img src="/images/playermap/inst-icon.gif" width="12" height="12" alt="">Instance</span>
  </div>

  <div id="maptip"></div>
</div>

<script type="text/javascript">
(function() {
  'use strict';

  var MAP_W = 966, MAP_H = 732;
  var MAX_MAP_H = 430;
  var baseScale = 1;
  var userZoom = 1;
  var panX = 0;
  var panY = 0;
  var isDragging = false;
  var dragStartX = 0;
  var dragStartY = 0;
  var dragPanX = 0;
  var dragPanY = 0;

  function clamp(v, min, max) {
    return Math.max(min, Math.min(max, v));
  }

  function clampPan() {
    var outer = document.getElementById('playermap-outer');
    if (!outer) return;

    var renderedW = MAP_W * baseScale * userZoom;
    var renderedH = MAP_H * baseScale * userZoom;
    var minX = Math.min(0, outer.clientWidth - renderedW);
    var minY = Math.min(0, outer.clientHeight - renderedH);

    panX = clamp(panX, minX, 0);
    panY = clamp(panY, minY, 0);
  }

  function updateZoomLabel() {
    var label = document.getElementById('map-zoom-label');
    if (label) label.innerHTML = Math.round(userZoom * 100) + '%';
  }

  function applyMapTransform() {
    var inner = document.getElementById('playermap-inner');
    var outer = document.getElementById('playermap-outer');
    if (!inner || !outer) return;

    clampPan();
    var renderScale = baseScale * userZoom;
    var renderedW = Math.max(1, Math.round(MAP_W * renderScale));
    var renderedH = Math.max(1, Math.round(MAP_H * renderScale));
    var mapLayers = inner.querySelectorAll('.map-layer');
    var pointLayers = inner.querySelectorAll('.points-layer');

    inner.style.left = Math.round(panX) + 'px';
    inner.style.top = Math.round(panY) + 'px';
    inner.style.width = renderedW + 'px';
    inner.style.height = renderedH + 'px';
    inner.style.transform = 'none';

    for (var i = 0; i < mapLayers.length; i++) {
      mapLayers[i].style.width = renderedW + 'px';
      mapLayers[i].style.height = renderedH + 'px';
      mapLayers[i].style.backgroundSize = renderedW + 'px ' + renderedH + 'px';
    }

    for (var j = 0; j < pointLayers.length; j++) {
      pointLayers[j].style.width = MAP_W + 'px';
      pointLayers[j].style.height = MAP_H + 'px';
      pointLayers[j].style.transform = 'scale(' + renderScale + ')';
    }

    outer.setAttribute('data-scale', renderScale.toFixed(3));
    outer.setAttribute('data-zoom', userZoom.toFixed(2));
    updateZoomLabel();
  }

  function scaleMap() {
    var outer = document.getElementById('playermap-outer');
    var inner = document.getElementById('playermap-inner');
    var stage = document.querySelector('.playermap-stage');
    if (!outer || !inner) return;

    var availW = stage ? Math.max(stage.clientWidth - 16, 1) : MAP_W;
    var heightScale = MAX_MAP_H / MAP_H;

    if (document.fullscreenElement && stage) {
      var availH = Math.max(stage.clientHeight - 18, 1);
      heightScale = availH / MAP_H;
    }

    baseScale = Math.min(availW / MAP_W, heightScale, 1);
    userZoom = clamp(userZoom, 1, 4);

    var scaledW = Math.floor(MAP_W * baseScale);
    var scaledH = Math.floor(MAP_H * baseScale);
    outer.style.width = scaledW + 'px';
    outer.style.height = scaledH + 'px';
    applyMapTransform();
  }

  function setMapZoom(nextZoom, anchorX, anchorY) {
    var outer = document.getElementById('playermap-outer');
    if (!outer) return;

    nextZoom = clamp(nextZoom, 1, 4);
    var rect = outer.getBoundingClientRect();
    var localX = typeof anchorX === 'number' ? anchorX - rect.left : outer.clientWidth / 2;
    var localY = typeof anchorY === 'number' ? anchorY - rect.top : outer.clientHeight / 2;
    var currentScale = baseScale * userZoom;
    var nextScale = baseScale * nextZoom;
    var mapX = (localX - panX) / currentScale;
    var mapY = (localY - panY) / currentScale;

    userZoom = nextZoom;
    panX = localX - mapX * nextScale;
    panY = localY - mapY * nextScale;
    applyMapTransform();
  }

  function zoomMapIn() {
    setMapZoom(userZoom * 1.25);
  }
  function zoomMapOut() {
    setMapZoom(userZoom / 1.25);
  }
  function resetMapZoom() {
    userZoom = 1;
    panX = 0;
    panY = 0;
    applyMapTransform();
  }

  window.zoomMapIn = zoomMapIn;
  window.zoomMapOut = zoomMapOut;
  window.resetMapZoom = resetMapZoom;

  function bindMapGestures() {
    var outer = document.getElementById('playermap-outer');
    if (!outer) return;

    outer.onwheel = function(e) {
      e.preventDefault();
      var factor = e.deltaY < 0 ? 1.18 : 1 / 1.18;
      setMapZoom(userZoom * factor, e.clientX, e.clientY);
    };

    outer.onmousedown = function(e) {
      if (e.button !== 0 || userZoom <= 1) return;
      isDragging = true;
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      dragPanX = panX;
      dragPanY = panY;
      outer.className = outer.className.replace(/\s*dragging/g, '') + ' dragging';
      e.preventDefault();
    };

    document.addEventListener('mousemove', function(e) {
      if (!isDragging) return;
      panX = dragPanX + (e.clientX - dragStartX);
      panY = dragPanY + (e.clientY - dragStartY);
      applyMapTransform();
    });

    document.addEventListener('mouseup', function() {
      if (!isDragging) return;
      isDragging = false;
      outer.className = outer.className.replace(/\s*dragging/g, '');
    });
  }

  scaleMap();
  bindMapGestures();
  if (window.requestAnimationFrame) {
    window.requestAnimationFrame(scaleMap);
  }
  window.addEventListener('resize', scaleMap);
  document.addEventListener('fullscreenchange', scaleMap);

  function toggleMapFullscreen() {
    var el = document.getElementById('playermap-page') || document.getElementById('playermap-outer');
    if (!document.fullscreenElement && el && el.requestFullscreen) {
      el.requestFullscreen();
    } else if (document.exitFullscreen) {
      document.exitFullscreen();
    }
  }
  window.toggleMapFullscreen = toggleMapFullscreen;

  var REFRESH_INTERVAL = 15000;
  var MAPS_COUNT = <%= mapsCount %>;
  var SHOW_OUTLAND = <%= showOutland ? 'true' : 'false' %>;
  var SHOW_NORTHREND = <%= showNorthrend ? 'true' : 'false' %>;
  var IMG_BASE = '/images/playermap/';
  var THEME_PATH = '<%= tp %>';
  var currentMap = 0;

  var raceName = {
    1:'Human', 2:'Orc', 3:'Dwarf', 4:'Night Elf', 5:'Undead',
    6:'Tauren', 7:'Gnome', 8:'Troll', 9:'Goblin', 10:'Blood Elf', 11:'Draenei'
  };
  var className = {
    1:'Warrior', 2:'Paladin', 3:'Hunter', 4:'Rogue', 5:'Priest',
    6:'Death Knight', 7:'Shaman', 8:'Mage', 9:'Warlock', 11:'Druid'
  };

  var instances_x = [];
  var instances_y = [];
  instances_x[0] = {30:762,33:712,34:732,35:732,36:712,43:245,47:238,48:172,70:833,90:738,109:849,129:254,189:773,209:269,229:782,230:778,249:290,269:315,289:816,309:782,329:834,349:123,369:745,389:308,409:783,429:164,449:741,450:305,469:778,489:244,509:160,529:820,531:144,532:798,534:317,560:320,568:897,572:750,580:868,585:883,595:322,618:313};
  instances_y[0] = {30:278,33:295,34:511,35:503,36:567,43:419,47:508,48:291,70:443,90:419,109:551,129:516,189:216,209:568,229:481,230:484,249:514,269:601,289:258,309:589,329:203,349:432,369:497,389:352,409:484,429:496,449:508,450:352,469:480,489:364,509:607,529:321,531:603,532:569,534:596,560:606,568:172,572:245,580:26,585:16,595:601,618:348};
  instances_x[1] = {540:593,542:586,543:593,544:588,545:393,546:399,547:388,548:399,550:683,552:680,553:672,554:669,555:495,556:506,557:495,558:483,559:408,562:443,564:740,565:485};
  instances_y[1] = {540:399,542:398,543:405,544:402,545:355,546:350,547:353,548:357,550:226,552:215,553:210,554:239,555:569,556:557,557:545,558:557,559:489,562:239,564:567,565:204};
  instances_x[2] = {533:568,574:749,575:751,576:161,578:159,599:553,600:605,601:395,602:575,603:559,604:740,608:470,615:491,616:155,617:457,619:400,624:363,631:400,632:415,649:475,650:465,658:393,668:410,724:491};
  instances_y[2] = {533:456,574:577,575:583,576:443,578:451,599:195,600:406,601:462,602:180,603:169,604:292,608:360,615:465,616:447,617:352,619:462,624:369,631:350,632:350,649:207,650:207,658:362,668:365,724:455};

  var maps_array = [0, 1, 530, 571, 609];

  function getPlayerPosition(x, y, m) {
    var where530 = 0;
    x = Math.round(x);
    y = Math.round(y);

    if (m == 530) {
      if (y < -1000 && y > -10000 && x > 5000) { x -= 10349; y += 6357; where530 = 1; }
      else if (y < -7000 && x < 0) { x += 3961; y += 13931; where530 = 2; }
      else { x -= 3070; y -= 1265; where530 = 3; }
    } else if (m == 609) {
      x -= 2355; y += 5662;
    }

    var xpos, ypos;
    if (where530 === 3) {
      xpos = Math.round(x * 0.051446);
      ypos = Math.round(y * 0.051446);
    } else if (m == 571) {
      xpos = Math.round(x * 0.050085);
      ypos = Math.round(y * 0.050085);
    } else {
      xpos = Math.round(x * 0.025140);
      ypos = Math.round(y * 0.025140);
    }

    var px = 0, py = 0;
    switch (String(m)) {
      case '530':
        if (where530 === 1) { px = 858 - ypos; py = 84 - xpos; }
        else if (where530 === 2) { px = 103 - ypos; py = 261 - xpos; }
        else if (where530 === 3) { px = 684 - ypos; py = 229 - xpos; }
        break;
      case '571': px = 505 - ypos; py = 642 - xpos; break;
      case '609': px = 896 - ypos; py = 232 - xpos; break;
      case '1': px = 194 - ypos; py = 398 - xpos; break;
      case '0': px = 752 - ypos; py = 291 - xpos; break;
      default: px = 194 - ypos; py = 398 - xpos; break;
    }
    return { x: px, y: py };
  }

  var mapIds = ['world', 'outland', 'northrend'];
  var pointIds = ['pointsOldworld', 'pointsOutland', 'pointsNorthrend'];
  var btnIds = ['btn-azeroth', 'btn-outland', 'btn-northrend'];

  function getMapLayer(id) { return document.getElementById(mapIds[id]); }
  function getPointsLayer(id) { return document.getElementById(pointIds[id]); }

  function switchWorld(n) {
    for (var i = 0; i < 3; i++) {
      var ml = getMapLayer(i);
      var pl = getPointsLayer(i);
      var btn = document.getElementById(btnIds[i]);
      if (ml) ml.style.visibility = (i === n) ? 'visible' : 'hidden';
      if (pl) pl.style.visibility = (i === n) ? 'visible' : 'hidden';
      if (btn) btn.className = (i === n) ? 'map-tab active' : 'map-tab';
    }
    currentMap = n;
  }
  window.switchWorld = switchWorld;

  var mouseX = 0, mouseY = 0;
  document.addEventListener('mousemove', function(e) {
    mouseX = e.clientX;
    mouseY = e.clientY;
  });

  function showTip(html) {
    var tip = document.getElementById('maptip');
    tip.innerHTML = html;
    var tw = tip.offsetWidth;
    var th = tip.offsetHeight;
    var vw = window.innerWidth;
    var vh = window.innerHeight;
    var tx = mouseX + 15;
    var ty = mouseY - 5;
    if (tx + tw > vw - 10) tx = mouseX - tw - 15;
    if (ty + th > vh - 10) ty = vh - th - 10;
    if (ty < 5) ty = 5;
    tip.style.left = tx + 'px';
    tip.style.top = ty + 'px';
  }

  function hideTip() {
    var tip = document.getElementById('maptip');
    tip.innerHTML = '';
    tip.style.left = '-1000px';
    tip.style.top = '-1000px';
  }

  function raceIcon(race, gender) {
    return IMG_BASE + 'c_icons/' + race + '-' + gender + '.gif';
  }
  function classIcon(cl) {
    return IMG_BASE + 'c_icons/' + cl + '.gif';
  }

  function inArray(val, arr) {
    for (var i = 0; i < arr.length; i++) {
      if (val == arr[i]) return true;
    }
    return false;
  }

  function statusTableHtml(online, total, totalBots, totalAlly, totalHorde) {
    var icon = online ? THEME_PATH + '/images/uparrow2.gif' : THEME_PATH + '/images/downarrow2.gif';
    var alt = online ? 'Up' : 'Down';
    return '<table cellpadding="3" cellspacing="0" width="100%"><tbody>'
      + '<tr>'
      + '<td class="rankingHeader" align="center" nowrap="nowrap">Status</td>'
      + '<td class="rankingHeader" align="center" nowrap="nowrap">Players</td>'
      + '<td class="rankingHeader" align="center" nowrap="nowrap">Bots</td>'
      + '<td class="rankingHeader" align="center" nowrap="nowrap">Alliance</td>'
      + '<td class="rankingHeader" align="center" nowrap="nowrap">Horde</td>'
      + '</tr>'
      + '<tr>'
      + '<td class="playermapRow1" align="center"><img src="' + icon + '" height="18" width="18" alt="' + alt + '" title="' + alt + '"></td>'
      + '<td class="playermapRow1" align="center"><b class="total-count">' + total + '</b></td>'
      + '<td class="playermapRow1" align="center"><b class="bot-count">' + totalBots + '</b></td>'
      + '<td class="playermapRow1" align="center"><b class="ally-count">' + totalAlly + '</b></td>'
      + '<td class="playermapRow1" align="center"><b class="horde-count">' + totalHorde + '</b></td>'
      + '</tr>'
      + '</tbody></table>';
  }

  function renderData(data) {
    var players = data && Array.isArray(data.players) ? data.players : [];
    var bots = data && Array.isArray(data.bots) ? data.bots : [];
    var status = data && data.status ? data.status : {};
    var isRealmOnline = status.online === true || Number(status.online) === 1;

    if (!data || (!isRealmOnline && players.length === 0 && bots.length === 0)) {
      for (var i = 0; i < 3; i++) {
        var pl = getPointsLayer(i);
        if (pl) pl.innerHTML = '';
      }
      document.getElementById('server_info').innerHTML = statusTableHtml(false, 0, 0, 0, 0);
      return;
    }

    var factionCounts = [];
    var botCounts = [];
    for (var m = 0; m < 3; m++) {
      factionCounts[m] = (data.factionCounts && Array.isArray(data.factionCounts[m])) ? data.factionCounts[m] : [0, 0];
      botCounts[m] = (data.botCounts && Array.isArray(data.botCounts[m])) ? data.botCounts[m] : [0, 0];
    }

    var layerHtml = ['', '', ''];
    var allEntries = [];
    for (var ap = 0; ap < players.length; ap++) allEntries.push({ ch: players[ap], isBot: false });
    for (var ab = 0; ab < bots.length; ab++) allEntries.push({ ch: bots[ab], isBot: true });

    for (var pi = 0; pi < allEntries.length; pi++) {
      var ch = allEntries[pi].ch;
      var isBotEntry = allEntries[pi].isBot;
      var ext = ch.Extention;

      if (ext === 1 && !SHOW_OUTLAND) continue;
      if (ext === 2 && !SHOW_NORTHREND) continue;

      var isHorde = (ch.race == 2 || ch.race == 5 || ch.race == 6 || ch.race == 8 || ch.race == 10);
      var factionColor = isHorde ? '#D2321E' : '#0096BE';
      var factionIcon = isHorde ? 'horde.gif' : 'allia.gif';
      var iconOpacity = isBotEntry ? '0.55' : '1';
      var entryType = isBotEntry ? 'Bot' : 'Player';

      if (inArray(parseInt(ch.map), maps_array)) {
        var pos = getPlayerPosition(ch.x, ch.y, ch.map);
        if (pos.x < 0 || pos.x > 966 || pos.y < 0 || pos.y > 732) continue;

        var tooltipHtml = '<div class="tip_single">'
          + '<div class="name" style="color:' + factionColor + ';">' + escHtml(ch.name) + '</div>'
          + '<div class="info">'
          + '<img src="' + raceIcon(ch.race, ch.gender) + '" width="18" height="18"> '
          + '<img src="' + classIcon(ch.cl) + '" width="18" height="18"><br>'
          + escHtml(raceName[ch.race] || '?') + ' ' + escHtml(className[ch.cl] || '?') + '<br>'
          + 'Level ' + ch.level + '<br>'
          + entryType + '<br>'
          + escHtml(ch.zone)
          + '</div></div>';

        layerHtml[ext] += '<img src="' + IMG_BASE + factionIcon + '" '
          + 'style="position:absolute;left:' + pos.x + 'px;top:' + pos.y + 'px;cursor:pointer;opacity:' + iconOpacity + ';" '
          + 'width="8" height="8" border="0" '
          + 'data-tip="' + escAttr(tooltipHtml) + '" '
          + 'onmousemove="this.parentNode._showTip(this)" '
          + 'onmouseout="this.parentNode._hideTip()">';
      } else {
        var ix = instances_x[ext] && instances_x[ext][parseInt(ch.map)];
        var iy = instances_y[ext] && instances_y[ext][parseInt(ch.map)];
        if (ix === undefined || iy === undefined) continue;

        var instTip = '<div class="tip_single">'
          + '<div class="name" style="color:' + factionColor + ';">' + escHtml(ch.name) + '</div>'
          + '<div class="info">'
          + escHtml(raceName[ch.race] || '?') + ' ' + escHtml(className[ch.cl] || '?') + '<br>'
          + 'Level ' + ch.level + '<br>'
          + entryType + '<br>'
          + escHtml(ch.zone) + ' (Instance)'
          + '</div></div>';

        layerHtml[ext] += '<img src="' + IMG_BASE + 'inst-icon.gif" '
          + 'style="position:absolute;left:' + ix + 'px;top:' + iy + 'px;cursor:pointer;opacity:' + iconOpacity + ';" '
          + 'width="12" height="12" border="0" '
          + 'data-tip="' + escAttr(instTip) + '" '
          + 'onmousemove="this.parentNode._showTip(this)" '
          + 'onmouseout="this.parentNode._hideTip()">';
      }
    }

    for (var li = 0; li < 3; li++) {
      var layer = getPointsLayer(li);
      if (layer) {
        layer.innerHTML = layerHtml[li];
        layer._showTip = function(el) { showTip(el.getAttribute('data-tip')); };
        layer._hideTip = hideTip;
      }
    }

    var totalAlly = 0, totalHorde = 0, totalBotAlly = 0, totalBotHorde = 0;
    for (var fi = 0; fi < 3; fi++) {
      totalAlly += factionCounts[fi][0];
      totalHorde += factionCounts[fi][1];
      totalBotAlly += botCounts[fi][0];
      totalBotHorde += botCounts[fi][1];
    }
    var total = totalAlly + totalHorde;
    var totalBots = totalBotAlly + totalBotHorde;
    document.getElementById('server_info').innerHTML = statusTableHtml(isRealmOnline, total, totalBots, totalAlly, totalHorde);
  }

  function escHtml(s) {
    if (!s) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function escAttr(s) {
    return escHtml(s).replace(/'/g,'&#39;');
  }

  function loadData() {
    fetch('/server/playermap/data')
      .then(function(res) { return res.json(); })
      .then(function(data) { renderData(data); })
      .catch(function() {
        document.getElementById('server_info').innerHTML =
          '<table cellpadding="3" cellspacing="0" width="100%"><tbody>'
          + '<tr><td class="rankingHeader" align="center">Status</td></tr>'
          + '<tr><td class="playermapRow1"><div class="playermap-error">Failed to load map data</div></td></tr>'
          + '</tbody></table>';
      });
  }

  loadData();
  setInterval(loadData, REFRESH_INTERVAL);
})();
</script>
