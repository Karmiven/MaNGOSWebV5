<h3 class="mb-2">Audit Log</h3>
<p class="text-muted small">Last 300 admin actions. Passwords and tokens are never stored.</p>

<div class="table-responsive">
  <table class="table table-dark table-hover table-sm">
    <thead>
      <tr><th>#</th><th>When</th><th>Admin</th><th>IP</th><th>Action</th><th>Details</th></tr>
    </thead>
    <tbody>
      <% if (entries && entries.length) { %>
        <% entries.forEach(e => { %>
          <tr>
            <td><%= e.id %></td>
            <td class="text-nowrap"><%= e.created_at ? helpers.formatDate(e.created_at) : '' %></td>
            <td><%= e.username %></td>
            <td><%= e.ip %></td>
            <td><code><%= e.action %></code></td>
            <td><small class="text-muted"><%= helpers.truncate(e.details || '', 160) %></small></td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="6" class="text-center text-muted">No entries yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
