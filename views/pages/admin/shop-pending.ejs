<h3 class="mb-2">Pending Purchases</h3>
<p class="text-muted small">
  Points were taken but delivery could not be confirmed (timeout, restart, or a partial mail).
  Check the character's mailbox in game, then mark it delivered or refund the points.
</p>

<div class="mb-3"><a href="/admin/shop" class="btn btn-sm btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back to shop</a></div>

<div class="table-responsive">
  <table class="table table-dark table-hover table-sm">
    <thead>
      <tr>
        <th>#</th><th>Account</th><th>Character</th><th>Item</th><th>Qty</th><th>Cost</th><th>Date</th><th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (purchases && purchases.length) { %>
        <% purchases.forEach(p => { %>
          <tr>
            <td><%= p.id %></td>
            <td><%= p.account_id %></td>
            <td><%= p.character_name %></td>
            <td><%= p.item_desc %> <code><%= p.item_number %></code></td>
            <td><%= p.quantity %></td>
            <td><%= p.wp_cost %></td>
            <td><%= p.created_at ? helpers.formatDate(p.created_at) : '' %></td>
            <td>
              <form method="POST" action="/admin/shop/pending/resolve" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="id" value="<%= p.id %>">
                <button name="action" value="complete" class="btn btn-sm btn-outline-success">Delivered</button>
                <button name="action" value="refund" class="btn btn-sm btn-outline-warning" onclick="return confirm('Refund <%= p.wp_cost %> points to account <%= p.account_id %>?')">Refund</button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="8" class="text-center text-muted">Nothing pending.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
