<%
  var tp = typeof themePath !== 'undefined' ? themePath : '/themes/wotlk';
  var series = registrations || [];
  var maxCount = Math.max(1, ...series.map(function(p) { return p.count; }));
  var last7 = series.slice(-7).reduce(function(a, p) { return a + p.count; }, 0);
  var last30 = series.reduce(function(a, p) { return a + p.count; }, 0);
  var today = series.length ? series[series.length - 1].count : 0;
  var W = 600, H = 130, PAD = 4;
  var slot = series.length ? W / series.length : W;
%>
<h3 class="mb-4">Dashboard</h3>

<div class="row mb-4">
  <div class="col-md-3 mb-3">
    <div class="card bg-dark border-secondary text-center">
      <div class="card-body">
        <div class="display-5 text-gold"><%= totalAccounts %></div>
        <div class="text-muted">Accounts <small>(+<%= today %> today)</small></div>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card bg-dark border-secondary text-center">
      <div class="card-body">
        <div class="display-5 text-gold"><%= totalChars %></div>
        <div class="text-muted">Characters</div>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card bg-dark border-secondary text-center">
      <div class="card-body">
        <div class="display-5 text-success"><%= onlinePlayers %></div>
        <div class="text-muted">Online Now</div>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card bg-dark border-secondary text-center">
      <div class="card-body">
        <div class="display-5 text-info"><%= totalNews %></div>
        <div class="text-muted">News Posts</div>
      </div>
    </div>
  </div>
</div>

<!-- Realms -->
<div class="row mb-2">
  <% if (realmCards && realmCards.length) { %>
    <% realmCards.forEach(function(r) { %>
      <div class="col-md-4 mb-3">
        <div class="card bg-dark border-secondary">
          <div class="card-body d-flex justify-content-between align-items-center">
            <div>
              <div class="text-gold fw-bold"><%= r.name %></div>
              <div class="text-muted small"><%= r.type %><% if (r.online) { %> &middot; up <%= r.uptime %><% } %></div>
            </div>
            <span class="badge <%= r.online ? 'bg-success' : 'bg-danger' %>"><%= r.online ? 'Online' : 'Offline' %></span>
          </div>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <div class="col-12 mb-3"><div class="text-muted small">No realms found.</div></div>
  <% } %>
</div>

<div class="row">
  <div class="col-lg-8 mb-4">
    <div class="card bg-dark border-secondary h-100">
      <div class="card-header text-gold d-flex justify-content-between">
        <span>New Accounts, last 30 days</span>
        <span class="text-muted small">7 days: <b class="text-light"><%= last7 %></b> &nbsp; 30 days: <b class="text-light"><%= last30 %></b></span>
      </div>
      <div class="card-body">
        <svg viewBox="0 0 <%= W %> <%= H + 18 %>" width="100%" role="img" aria-label="New accounts per day">
          <line x1="0" y1="<%= H %>" x2="<%= W %>" y2="<%= H %>" stroke="#5D5D5D" stroke-width="1"/>
          <line x1="0" y1="<%= PAD %>" x2="<%= W %>" y2="<%= PAD %>" stroke="#3a3a3a" stroke-width="1" stroke-dasharray="3 4"/>
          <text x="2" y="<%= PAD + 10 %>" fill="#8a8a8a" font-size="10"><%= maxCount %></text>
          <% series.forEach(function(p, i) {
            var h = p.count ? Math.max(2, Math.round((p.count / maxCount) * (H - PAD - 12))) : 0;
          %>
            <rect x="<%= (i * slot + 2).toFixed(1) %>" y="<%= H - h %>" width="<%= (slot - 4).toFixed(1) %>" height="<%= h %>" fill="#d0a803" opacity="<%= p.count ? 0.9 : 0 %>">
              <title><%= p.day %>: <%= p.count %></title>
            </rect>
          <% }); %>
          <% if (series.length) { %>
            <text x="2" y="<%= H + 13 %>" fill="#8a8a8a" font-size="10"><%= series[0].day %></text>
            <text x="<%= W - 2 %>" y="<%= H + 13 %>" fill="#8a8a8a" font-size="10" text-anchor="end"><%= series[series.length - 1].day %></text>
          <% } %>
        </svg>
      </div>
    </div>
  </div>

  <div class="col-lg-4 mb-4">
    <div class="card bg-dark border-secondary mb-3">
      <div class="card-header text-gold">Needs Attention</div>
      <div class="list-group list-group-flush">
        <a href="/admin/shop/pending" class="list-group-item list-group-item-action bg-dark text-light border-secondary d-flex justify-content-between">
          Pending purchases <span class="badge <%= counters.pendingPurchases ? 'bg-warning text-dark' : 'bg-secondary' %>"><%= counters.pendingPurchases %></span>
        </a>
        <a href="/admin/logs/soap" class="list-group-item list-group-item-action bg-dark text-light border-secondary d-flex justify-content-between">
          Failed SOAP commands, 24h <span class="badge <%= counters.failedSoap ? 'bg-danger' : 'bg-secondary' %>"><%= counters.failedSoap %></span>
        </a>
        <a href="/admin/logs/purchases" class="list-group-item list-group-item-action bg-dark text-light border-secondary d-flex justify-content-between">
          Purchases, 24h <span class="badge bg-secondary"><%= counters.purchasesToday %></span>
        </a>
      </div>
    </div>

    <div class="card bg-dark border-secondary">
      <div class="card-header text-gold">Online Stats</div>
      <div class="card-body">
        <% if (onlineStats) { %>
          <p class="mb-2"><img src="<%= tp %>/images/icon/faction/alliance.gif" height="18" width="18" alt="Alliance" style="vertical-align:middle;"> Alliance: <span class="text-primary fw-bold"><%= onlineStats.alliance || 0 %></span></p>
          <p class="mb-2"><img src="<%= tp %>/images/icon/faction/horde.gif" height="18" width="18" alt="Horde" style="vertical-align:middle;"> Horde: <span class="text-danger fw-bold"><%= onlineStats.horde || 0 %></span></p>
          <p class="mb-2">Unique IPs: <span class="text-info fw-bold"><%= onlineStats.uniqueIPs || 0 %></span></p>
          <p class="mb-0">Total Online: <span class="text-success fw-bold"><%= onlineStats.total || 0 %></span></p>
        <% } else { %>
          <p class="text-muted mb-0">No stats available.</p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<div class="card bg-dark border-secondary mb-4">
  <div class="card-header text-gold">Quick Actions</div>
  <div class="card-body d-flex flex-wrap gap-2">
    <a href="/admin/users" class="btn btn-sm btn-outline-light"><i class="fas fa-users me-1"></i>Users</a>
    <a href="/admin/news" class="btn btn-sm btn-outline-light"><i class="fas fa-newspaper me-1"></i>News</a>
    <a href="/admin/shop" class="btn btn-sm btn-outline-light"><i class="fas fa-shopping-cart me-1"></i>Shop</a>
    <a href="/admin/vote" class="btn btn-sm btn-outline-light"><i class="fas fa-gift me-1"></i>Daily Rewards</a>
    <a href="/admin/gamemail" class="btn btn-sm btn-outline-light"><i class="fas fa-envelope me-1"></i>Game Mail</a>
    <a href="/admin/chartools" class="btn btn-sm btn-outline-light"><i class="fas fa-user-cog me-1"></i>Character Tools</a>
    <a href="/admin/banlist" class="btn btn-sm btn-outline-light"><i class="fas fa-ban me-1"></i>Ban List</a>
    <a href="/admin/siteconfig" class="btn btn-sm btn-outline-light"><i class="fas fa-cog me-1"></i>Site Config</a>
  </div>
</div>
